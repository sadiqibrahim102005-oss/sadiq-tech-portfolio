/* ================= CONTACT ================= */

function sendMessage(){

const name =
document
.getElementById("name")
.value
.trim();

const email =
document
.getElementById("email")
.value
.trim();

const message =
document
.getElementById("message")
.value
.trim();


if(
name === "" ||
email === "" ||
message === ""
){

alert(
"⚠️ Please fill all fields."
);

return;

}


alert(

"✅ Thank you " +
name +
"! Your message has been received."

);


document
.getElementById("name")
.value = "";

document
.getElementById("email")
.value = "";

document
.getElementById("message")
.value = "";

}


